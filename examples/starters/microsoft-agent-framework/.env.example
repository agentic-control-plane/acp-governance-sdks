# ── ACP credentials ──────────────────────────────────────────────────
# Get yours: cloud.agenticcontrolplane.com → Settings → API Keys
# Format: gsk_<tenant-slug>_<random>
ACP_USER_TOKEN=gsk_your-slug_replace-me
ACP_GATEWAY_URL=https://api.agenticcontrolplane.com

# ── LLM provider (MAF's chat client reads this directly) ─────────────
# Swap to OPENAI_API_KEY / AZURE_OPENAI_* if you change the client in
# starter.py (e.g. agent_framework.openai.OpenAIChatClient).
ANTHROPIC_API_KEY=sk-ant-replace-me
